---
import ScorePanel from "@/components/ScorePanel.astro";
import { BOARD_HEIGHT, BOARD_WIDTH } from "@/game/theme";
import { withBase } from "@/lib/paths";
---

<div class="game">
  <section class="stage">
    <canvas
      class="board"
      data-game-canvas
      width={BOARD_WIDTH}
      height={BOARD_HEIGHT}
      aria-label="游戏棋盘"
      role="img"></canvas>
  </section>

  <aside class="panel" data-drawably="card">
    <ScorePanel />

    <div class="actions">
      <button class="btn" type="button" data-drawably="button" data-mute aria-pressed="true">
        <img class="ico icon-on" src={withBase("icons/volume.svg")} alt="" width="16" height="16" />
        <img
          class="ico icon-off"
          src={withBase("icons/volume-mute.svg")}
          alt=""
          width="16"
          height="16"
          hidden
        />
        <span class="lbl">音效开</span>
      </button>
      <button class="btn btn-primary" type="button" data-drawably="button" data-restart>
        <img class="ico" src={withBase("icons/restart.svg")} alt="" width="16" height="16" />
        <span class="lbl">重开</span>
      </button>
    </div>

    <p class="tips">
      鼠标：移动瞄准，点击投放。<br />
      触屏：拖动瞄准，松手投放。<br />
      方向键微调 · 空格投放 · R 重开。
    </p>
  </aside>

  <!-- Mobile-only hand-drawn tray behind the top HUD (hidden on desktop). -->
  <div class="mobile-hud-card" data-drawably="card" aria-hidden="true"></div>
</div>

<footer class="site-footer">
  <p>
    最高分只保存在本机浏览器 · v{import.meta.env.PUBLIC_APP_VERSION ?? "0.1.0"} ·
    友链：<a href="https://huaxiaoke.com/download" target="_blank" rel="noopener noreferrer">华小科 表情包下载</a>
  </p>
</footer>

<script>
  import { mount } from "@/game/mount";

  let unmount: (() => void) | null = null;

  const bootGame = (): void => {
    unmount?.();
    unmount = null;

    const canvas = document.querySelector<HTMLCanvasElement>("[data-game-canvas]");
    const nextCanvas = document.querySelector<HTMLCanvasElement>("[data-next]");
    const chainCanvas = document.querySelector<HTMLCanvasElement>("[data-chain]");
    const restartBtn = document.querySelector<HTMLButtonElement>("[data-restart]");
    const muteBtn = document.querySelector<HTMLButtonElement>("[data-mute]");

    if (!canvas || !nextCanvas || !chainCanvas || !restartBtn || !muteBtn) return;

    requestAnimationFrame(() => {
      if (!document.contains(canvas)) return;
      unmount?.();
      unmount = mount({ canvas, nextCanvas, chainCanvas, restartBtn, muteBtn });
    });
  };

  document.addEventListener("astro:page-load", bootGame);
  document.addEventListener("astro:before-swap", () => {
    unmount?.();
    unmount = null;
  });
</script>

<style>
  .game {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 1.15rem;
    width: 100%;
    min-height: 0;
    flex: 1 1 auto;
  }

  .mobile-hud-card {
    display: none;
  }

  .stage {
    position: relative;
    height: min(78dvh, 100%);
    min-height: 0;
    aspect-ratio: 640 / 900;
    flex: 0 0 auto;
    padding: 0.55rem 0.55rem 0;
    border-radius: calc(var(--radius) + 0.4rem);
    background: #fffafc;
    box-shadow: inset 0 0 0 1px rgb(24 24 27 / 8%);
  }

  .board {
    display: block;
    width: 100%;
    height: calc(100% - 0.55rem);
    touch-action: none;
    cursor: pointer;
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 15.5rem;
    flex: 0 0 auto;
    padding: 1rem 1.05rem 1.1rem;
    border-radius: calc(var(--radius) + 0.35rem);
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.18rem;
    min-width: 0;
    padding: 0.5rem 0.5rem 0.55rem;
    font: inherit;
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--accent);
    text-align: center;
    cursor: pointer;
  }

  .btn .ico {
    display: block;
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
  }

  .btn .ico[hidden] {
    display: none;
  }

  .btn .lbl {
    display: block;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tips {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.6;
    text-align: center;
    color: var(--ink-soft);
  }

  @media (max-width: 48rem) {
    .game {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        "hud hud"
        "stage stage"
        "next chain";
      align-items: stretch;
      justify-content: stretch;
      gap: 0.3rem;
      width: 100%;
      flex: 1 1 auto;
      min-height: 0;
    }

    .mobile-hud-card {
      display: block;
      grid-area: hud;
      position: relative;
      align-self: center;
      height: 3.2rem;
      max-height: 3.2rem;
      min-height: 0;
      border-radius: calc(var(--radius) + 0.15rem);
      z-index: 0;
      pointer-events: none;
    }

    .mobile-hud-card :global(.drawably-svg),
    .mobile-hud-card.drawably-host > :global(.drawably-svg) {
      position: absolute !important;
      inset: -3px;
      width: calc(100% + 6px) !important;
      height: calc(100% + 6px) !important;
      max-width: none !important;
      max-height: none !important;
    }

    .panel {
      display: contents;
      width: auto;
      padding: 0;
    }

    .panel :global(.drawably-svg),
    .panel.drawably-host > :global(.drawably-svg) {
      display: none;
    }

    .tips {
      display: none;
    }

    .actions {
      grid-area: hud;
      display: flex;
      align-items: center;
      justify-self: end;
      align-self: center;
      height: 3.2rem;
      gap: 0.25rem;
      padding: 0.55rem 0.5rem 0.55rem 0.15rem;
      margin: 0;
      z-index: 1;
      box-sizing: border-box;
    }

    .btn {
      flex-direction: row;
      gap: 0;
      min-width: 1.9rem;
      min-height: 1.9rem;
      width: 1.9rem;
      height: 1.9rem;
      padding: 0.2rem;
      font-size: 0.7rem;
    }

    .btn .ico {
      width: 0.95rem;
      height: 0.95rem;
    }

    .btn .lbl {
      display: none;
    }

    .stage {
      grid-area: stage;
      width: min(100%, calc((100dvh - 8.2rem) * 640 / 900));
      max-width: 100%;
      height: auto;
      max-height: calc(100dvh - 8.2rem);
      aspect-ratio: 640 / 900;
      margin: 0 auto;
      padding: 0.3rem 0.3rem 0;
    }

    .board {
      height: calc(100% - 0.3rem);
    }
  }
</style>
