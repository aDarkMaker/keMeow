---
import { formatScore, readBest } from "@/lib/storage";

const NEXT_WIDTH = 160;
const NEXT_HEIGHT = 160;
const CHAIN_WIDTH = 680;
const CHAIN_HEIGHT = 112;

const best = formatScore(readBest());
---

<header class="panel-head">
  <h1>keMeow</h1>
  <p class="subtitle">Match two of a kind, grow the mood</p>
</header>

<div class="stats">
  <div class="stat">
    <span class="stat-label">分数</span>
    <strong class="stat-value" data-hud="score">0</strong>
  </div>
  <div class="stat">
    <span class="stat-label">最高</span>
    <strong class="stat-value stat-best" data-hud="best">{best}</strong>
  </div>
</div>

<div class="next-box">
  <span class="box-label">下一个</span>
  <canvas
    id="next"
    data-next
    width={NEXT_WIDTH}
    height={NEXT_HEIGHT}
    data-logical-width={NEXT_WIDTH}
    data-logical-height={NEXT_HEIGHT}
    aria-label="下一个表情"></canvas>
</div>

<div class="chain-box">
  <span class="box-label">合成链</span>
  <canvas
    id="chain"
    data-chain
    width={CHAIN_WIDTH}
    height={CHAIN_HEIGHT}
    data-logical-width={CHAIN_WIDTH}
    data-logical-height={CHAIN_HEIGHT}
    aria-label="合成顺序"></canvas>
</div>

<style>
  .panel-head h1 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.15;
    color: var(--accent);
  }

  .subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .stat {
    min-width: 0;
    padding: 0.5rem 0.65rem;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 62%);
    box-shadow: 0 4px 14px rgb(24 24 27 / 6%);
  }

  .stat-label {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .stat-value {
    display: block;
    margin-top: 0.1rem;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .stat-best {
    color: #d98b1f;
  }

  .next-box,
  .chain-box {
    min-width: 0;
    padding: 0.5rem 0.65rem;
    border-radius: 0.8rem;
    background: rgb(255 255 255 / 62%);
    box-shadow: 0 4px 14px rgb(24 24 27 / 6%);
  }

  .box-label {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  #next {
    display: block;
    width: 4.75rem;
    height: 4.75rem;
    margin: 0.125rem auto 0;
  }

  #chain {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 48rem) {
    .panel-head {
      display: none;
    }

    .stats {
      grid-area: hud;
      grid-template-columns: 1fr 1fr;
      gap: 0.25rem;
      align-self: center;
      justify-self: stretch;
      width: auto;
      max-width: none;
      height: 3.2rem;
      margin: 0;
      padding: 0.55rem 4.5rem 0.55rem 0.55rem;
      z-index: 1;
      min-width: 0;
      box-sizing: border-box;
    }

    .stat {
      padding: 0.1rem 0.4rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
    }

    .stat-label {
      font-size: 0.48rem;
      line-height: 1;
    }

    .stat-value {
      margin-top: 0;
      font-size: 1.05rem;
      line-height: 1.05;
    }

    .next-box,
    .chain-box {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0.08rem;
      height: 4.1rem;
      min-height: 4.1rem;
      max-height: 4.1rem;
      min-width: 0;
      padding: 0.22rem 0.28rem;
      overflow: hidden;
      box-sizing: border-box;
      align-self: stretch;
    }

    .next-box {
      grid-area: next;
      width: 4.1rem;
      flex: none;
    }

    .chain-box {
      grid-area: chain;
    }

    .box-label {
      margin-bottom: 0;
      text-align: center;
      font-size: 0.48rem;
      line-height: 1;
      flex: none;
    }

    #next {
      display: block;
      flex: 1 1 auto;
      width: auto;
      height: 0;
      min-height: 0;
      aspect-ratio: 1;
      max-width: 100%;
      margin: 0 auto;
    }

    #chain {
      display: block;
      flex: 1 1 auto;
      width: 100%;
      height: 0;
      min-height: 0;
      margin: 0;
    }
  }
</style>
